{
    "name": "@la-bete/ccgen",
    "version": "1.0.0",
    "description": "Generate Luhn-valid test card numbers from Nigerian issuer BINs",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "prepublishOnly": "npm run build && npm test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/la-bete/ccgen.git"
    },
    "keywords": [
        "test-card",
        "card-number",
        "pan",
        "bin",
        "luhn",
        "nigeria",
        "payments",
        "generator"
    ],
    "author": "La-BeTe",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/la-bete/ccgen/issues"
    },
    "homepage": "https://github.com/la-bete/ccgen#readme",
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.20.5",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "typescript": "^5.9.3"
    }
}
